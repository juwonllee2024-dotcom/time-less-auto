{
  "manifest_version": 3,
  "name": "Time Less Auto",
  "version": "2.0.0",
  "description": "Fully automated web-AI project planning, role injection, verified response captures, and ZIP packaging.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "alarms",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Time Less Auto",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "response-capture-policy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
